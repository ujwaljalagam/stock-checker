# Copy to .env and load it before starting the server, e.g.:
#   set -a; . ./.env; set +a; ./gradlew :server:run
# Never commit the real .env.

# --- Server ---
PORT=8080
# Public URL of the site (used in notification links and emails)
PUBLIC_BASE_URL=http://localhost:8080
# true: sign-in codes are logged and returned by the API. MUST be false in production.
DEV_MODE=true
# Optional comma-separated origins allowed to call the API cross-origin (not needed when the server hosts the web app)
# CORS_HOSTS=http://localhost:8081

# --- Database (defaults to an H2 file DB in ./server/data) ---
# DATABASE_URL=jdbc:postgresql://localhost:5432/stockchecker
# DATABASE_USER=stockchecker
# DATABASE_PASSWORD=change-me

# --- Web Push (generate with ./gradlew -q :server:generateVapidKeys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email (leave SMTP_HOST empty to print emails to the server log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Stock Checker <alerts@example.com>
SMTP_STARTTLS=true

# --- Retailers ---
# Best Buy Products API key (enables the "bestbuy" retailer)
BESTBUY_API_KEY=
# BESTBUY_API_BASE_URL=https://api.bestbuy.com/v1
# Demo retailer with predictable behaviour (turn off in production)
ENABLE_MOCK_RETAILER=true

# --- Scheduler ---
SCHEDULER_ENABLED=true
# How often each watch is re-checked
CHECK_INTERVAL_SECONDS=300
# Email an alert if no device confirmed showing the push within this many minutes
EMAIL_FALLBACK_MINUTES=10

# --- Web app location (defaults to webApp/build/dist/wasmJs/productionExecutable) ---
# WEB_STATIC_DIR=/srv/stockchecker/web
